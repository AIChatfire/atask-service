# 本文件是键名的**唯一权威清单**：键名 = Settings 字段名大写、**不带前缀**。
# **不提供任何旧键名或别名兼容**——配置加载对未知变量静默忽略（extra="ignore"），
# 所以**写错键名不会有任何提示**，网关会带默认值启动（默认 DATABASE_URL 指向
# root:root@127.0.0.1，表现为连库失败而非配置报错）。请逐项核对。
# **本文件的值是样例 / 生产建议值，不是代码默认值**——需要默认值请看 app/config.py；
# 极少数项在注释里标了「代码默认」，其余请勿据本文件推断默认行为。

# ===== 数据层 =====
# 复用 new-api 的 MySQL 实例（tasks 表；网关零建表职责）
# 本文件是**样例**，所有凭据位一律占位符——绝不把真实口令写进仓库（泄露即等于
# 交出 tasks 表读写权 + 回调伪造能力；轮换成本远高于改一个文件）
DATABASE_URL=mysql+asyncmy://USER:PASSWORD@MYSQL_HOST:3306/oneapi-master?charset=utf8mb4
# 连接池：与 new-api 共享同一 MySQL 实例，池大小 × (gunicorn worker 数 + worker
# 副本数) 必须留在实例 max_connections 预算内（gunicorn.conf.py 按此反推 worker 数）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800              # 必须小于 MySQL wait_timeout，否则取到已被服务端关闭的连接
DB_POOL_PRE_PING=true             # 取连接前探活，吃掉 wait_timeout 竞态
# ---- 仅 gunicorn 读取（**不是** Settings 字段，故不在「配置项与样例对齐」门禁的
# 校验范围内，只能靠这段注释保证运维知道它们存在）----
# 这三个值决定 gunicorn 起几个 worker：
#   workers = min(CPU 上限, DB_MAX_CONNECTIONS × DB_WEB_SHARE ÷ (DB_POOL_SIZE + DB_MAX_OVERFLOW))
# 依据是「与 new-api 共用同一 MySQL 实例」——打爆 max_connections 会级联拖垮 new-api，
# 所以 CPU 只是上限、不是依据。改任何一项前先读 gunicorn.conf.py 的预算推导。
# DB_MAX_CONNECTIONS=200        # 该 MySQL 实例的 max_connections 预算（与 new-api 共用，保守取 200）
# DB_WEB_SHARE=0.6              # web 可占预算比例；余下留给 taskiq worker 各持的连接池与 new-api 自用
# Redis 由本项目容器化（docker compose 内服务名为 redis）
REDIS_URL=redis://redis:6379/0

# ===== 网关自身 =====
GATEWAY_PLATFORM=atask                         # tasks.platform 标记（与 stask-service 的 'stask' 对称）
# ADMIN_TOKEN=                                  # 管理面（/ops/* 与 /admin/*）X-Admin-Token；未配置时整个管理面返回 404（fail-closed，不暴露端点存在）

# ===== 鉴权/幂等/限流 =====
IDEM_TTL=86400
IDEM_PENDING_TTL_SECONDS=30       # 幂等占位（pending）TTL：覆盖受理→落库回填窗口
IDEM_REPLAY_WAIT_SECONDS=25       # 同键并发等占位回填上限（超时按 409 冲突处理）
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_TASKS=5
# 并发槽键 TTL 兜底（防「占槽后崩溃」永久泄漏；每次 acquire 刷新）——必须 > 最长任务在途时长
CONC_TTL_SECONDS=172800

# ===== 用户令牌会话 =====
# 探测/取消需用用户本人令牌；令牌只进 Redis 会话（终态清除），绝不落库
SK_SESSION_TTL_SECONDS=172800     # 48h；会话过期后任务无法自愈（见 ADR-010 已知限制）

# ===== 用户回调投递 =====
# 强随机值（openssl rand -hex 16）；占位符禁止上生产——泄露即可伪造用户回调
CALLBACK_SIGN_SECRET=REPLACE_ME_openssl_rand_hex_16

# ===== /batch 后台收敛 =====
TASK_STALE_SECONDS=300            # 非终态任务超过该时长未更新则 sweeper 探测推进

# ===== 上游数据面（提交/探测出站）=====
# 上游寻址（见本仓库 ADR-010）：X-Upstream-Base-Url 头优先（nginx 无条件覆盖注入），
# 回退 UPSTREAM_BASE_URL。去掉 keypool 后它取代了渠道元数据里的 base_url。
# **host 必须命中下方 UPSTREAM_ALLOWLIST**，否则 assert_upstream_allowed 直接 400——
# 注意下面两条样例是配套的，改一条要同时改另一条。
UPSTREAM_BASE_URL=http://newapi.internal:3000
# 允许的上游 host 列表（逗号分隔，端口不参与命中）；**空 = 全部拒绝**（fail-closed，
# 这是防「用户 sk 打到野地址」的第二道防线，勿留空上生产）
UPSTREAM_ALLOWLIST=newapi.internal,10.0.0.5
UPSTREAM_BREAKER_THRESHOLD=10     # 熔断：窗口内失败 N 次打开
UPSTREAM_BREAKER_WINDOW_SECONDS=30

# ===== /batch 中继（ADR-010：鉴权与计费全部下沉上游）=====
# 约定式链路不再有渠道级 timeout_sec（渠道元数据随 keypool 一并放弃），
# 出站超时降级为这一个全局默认值（提交/探测/取消共用）
RELAY_TIMEOUT_SECONDS=60.0
# 受理提交体大小上限（字节）：防超大提交体把网关进程内存打爆，超限返回 413。
# Content-Length 可缺失（chunked）也可被伪造，故实际按读取过程逐块累加封顶，不只看头。
BODY_MAX_BYTES=1048576
# 免费 GET 透传（流式转发）时上游**声明**的响应体长度上限（字节）：超限即 502
# 且不开始流式（body 一个字节都不消费）。未声明长度（chunked）不设中途截断——
# 流式本身已把内存占用限成常数，中途截断只会给客户端一个无错误信号的截断体。
UPSTREAM_RESPONSE_MAX_BYTES=104857600
# 路径准入硬拒前缀（逗号分隔，逗号两侧可有空格）：/batch/{path} 命中即拒（403），
# 防把上游管理面/控制台路径经本网关暴露出去
BATCH_DENY_PREFIXES=/api/,/console/

# ===== Sweep（每分钟补数巡检）=====
BATCH_SWEEP_BATCH=50              # 每轮 /batch 后台收敛（探测推进终态）上限；回收敛间隔复用 TASK_STALE_SECONDS
# /batch 收敛独立重入锁 TTL（秒）：慢轮不叠加并发轮（多副本同理）
BATCH_SWEEP_LOCK_TTL_SECONDS=300
QUEUE_STATS_CACHE_SECONDS=55      # 队列观测快照缓存（全库 scan + GROUP BY 降频）

# ===== 队列 =====
EVENT_MAX_ATTEMPTS=8
# worker 并发上限（taskiq --max-async-tasks）：worker 的活儿是 await 上游 HTTP，
# 设小会让队列白积压；但每个在飞任务持有 DB 会话，与 web 共享同一份连接预算
QUEUE_MAX_ASYNC_TASKS=10240
# 由 gunicorn.conf.py 读（**不是本应用的 Settings 字段**）；不设则由 DB 连接预算反推。
GUNICORN_WORKERS=3
# taskiq-admin 看板（可选；配了 worker 才上报；面板只绑 127.0.0.1:3000）
TASKIQ_ADMIN_URL=http://taskiq-admin:3000
TASKIQ_ADMIN_API_TOKEN=REPLACE_ME_openssl_rand_hex_16   # 与看板 TASKIQ_ADMIN_API_TOKEN 一致

# ===== 观测 =====
APP_ENV=dev                              # prod / staging / dev：进 logfire environment 字段
APP_VERSION=dev                          # 部署时注入镜像 tag，用于区分 trace 来自哪个版本
# 日志：loguru 统一装配（app/logging.py），级别 DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=DEBUG
# 占位符 token 也会被当作「有 token」——在此之前开着它只会持续 401 刷屏，
# 并把 pytest 的汇总行挤掉。拿到真实 token 后再改 true。
LOGFIRE_ENABLED=false
LOGFIRE_TOKEN=REPLACE_ME_pylf_v1_...
# logfire 噪音路由排除（逗号分隔；探针与运维端点不进 trace 面板）
LOGFIRE_EXCLUDED_URLS=/healthz/live,/healthz/ready,/ops/queue,/ops/requeue,/ops/dlq/replay,/ops/tasks
