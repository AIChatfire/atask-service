# ===== 数据层 =====
# 复用 NewAPI 的 MySQL 实例（不在本项目编排内；容器内访问宿主机用 host.docker.internal）
GW_DATABASE_URL=mysql+asyncmy://root:root@host.docker.internal:3306/newapi?charset=utf8mb4
# Redis 由本项目容器化（docker compose 内服务名为 redis）
GW_REDIS_URL=redis://redis:6379/0

# ===== 已有微服务（providers 适配层，换实现改下方 *_PROVIDER）=====
GW_BILLING_PROVIDER=newapi-billing           # newapi-billing-service
GW_BILLING_SVC_URL=http://104.238.221.50:8080
GW_BILLING_ADMIN_TOKEN=sk-admin-xxx          # worker 侧结算用的服务账号凭证
GW_PRICING_PROVIDER=model-meta               # 模型元数据定价：GET /v1/models/{model}
GW_PRICING_SVC_URL=http://127.0.0.1:9001
GW_KEY_PROVIDER=keypool                      # keypool-service
GW_KEY_SVC_URL=http://104.238.221.50:8081
GW_KEY_SVC_TOKEN=change-me                   # keypool 服务级 Bearer token

# ===== 配置中心微服务（动态路由主源）=====
GW_CONFIG_SVC_URL=http://127.0.0.1:9004    # GET {url}/gateway/routes
GW_CONFIG_PULL_INTERVAL=10                 # 拉取间隔（秒）

# ===== 网关自身 =====
GW_ROUTES_FILE=gateway-routes.yaml         # 兜底/bootstrap 配置
GW_CALLBACK_SIGN_SECRET=change-me            # 推送给用户 callback_url 的 HMAC 签名密钥
GW_FREEZE_TTL_SECONDS=1800                   # 预冻结 TTL（最后兜底防线）
GW_RATE_LIMIT_PER_MINUTE=60
GW_MAX_CONCURRENT_TASKS=5                    # 每用户并发任务上限
GW_SWEEP_INTERVAL_SECONDS=60
GW_TASK_STALE_SECONDS=300                    # 非终态任务超过该时长未更新则巡检
GW_DB_POOL_SIZE=20
GW_DB_MAX_OVERFLOW=10

# ===== 观测 =====
GW_LOGFIRE_ENABLED=false
# GW_LOGFIRE_TOKEN=xxx
