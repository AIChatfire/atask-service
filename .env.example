# ===== 数据层 =====
# 复用 new-api 的 MySQL 实例（tasks 表；网关零建表职责）
GW_DATABASE_URL=mysql+asyncmy://root:root@host.docker.internal:3306/newapi?charset=utf8mb4
# Redis 由本项目容器化（docker compose 内服务名为 redis）
GW_REDIS_URL=redis://redis:6379/0

# ===== 微服务（providers 适配层，换实现改 *_PROVIDER）=====
# newapi-billing-service：身份内省 + 冻结/结算/取消（https://github.com/AIChatfire/newapi-billing-service）
GW_BILLING_PROVIDER=newapi-billing
GW_BILLING_SVC_URL=http://127.0.0.1:8080
# pricing-service：模型元数据 + 计费规则（https://github.com/AIChatfire/pricing-service）
GW_PRICING_PROVIDER=model-meta
GW_PRICING_SVC_URL=http://127.0.0.1:9001
GW_PRICING_CACHE_TTL=300
# keypool-service：上游 key 租约 + 渠道覆盖 + 路由提取配置（唯一事实源）
# 全部渠道挂在统一分组（默认 keypool）下集中维护；接入新模型 = 渠道挂进分组 +
# 配 setting.gateway 块 + pricing 规则，网关零维护
GW_KEY_PROVIDER=keypool
GW_KEY_SVC_URL=http://127.0.0.1:8081
GW_KEY_SVC_TOKEN=change-me                   # keypool 服务级 AUTH_TOKEN
GW_KEY_GROUP=keypool                         # 统一分组名（渠道选择 group）

# ===== 网关自身 =====
GW_GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8000   # 注入上游 callback_url 的公网基址
GW_GATEWAY_PLATFORM=gateway                        # tasks.platform 标记
# GW_ADMIN_TOKEN=                                  # /ops/* X-Admin-Token；空则靠内网隔离
GW_HTTP_TIMEOUT=10

# ===== 计费闭环 =====
GW_FREEZE_TTL_SECONDS=1800                 # 预冻结 TTL（billing sweeper 过期自动解冻兜底）
GW_SK_SESSION_TTL_SECONDS=172800           # 用户令牌 Redis 暂存 TTL（终态结算用）

# ===== 鉴权/幂等/限流 =====
GW_AUTH_CACHE_TTL=30
GW_IDEM_TTL=86400
GW_RATE_LIMIT_PER_MINUTE=60
GW_MAX_CONCURRENT_TASKS=5

# ===== 用户回调投递 =====
GW_CALLBACK_SIGN_SECRET=change-me
GW_CB_DEDUP_TTL=259200

# ===== 探测（不支持回调的上游）=====
GW_POLL_LADDER_SECONDS=5,15,30,120
GW_POLL_MAX_AGE_SECONDS=86400
GW_TASK_STALE_SECONDS=300

# ===== 队列 =====
GW_EVENT_MAX_ATTEMPTS=8
GW_QUEUE_WARN_DEPTH=500

# ===== 观测 =====
GW_LOGFIRE_ENABLED=false
# GW_LOGFIRE_TOKEN=xxx
