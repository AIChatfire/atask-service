# ===== 数据层 =====
# 复用 new-api 的 MySQL 实例（tasks 表；网关零建表职责）
GW_DATABASE_URL=mysql+asyncmy://root:cbe1449JtNx7hMm8@103.207.68.201:3306/oneapi-master?charset=utf8mb4
# Redis 由本项目容器化（docker compose 内服务名为 redis）
GW_REDIS_URL=redis://redis:6379/0

# ===== 微服务（providers 适配层，换实现改 *_PROVIDER）=====
# newapi-billing-service：身份内省 + 冻结/结算/取消（https://github.com/AIChatfire/newapi-billing-service）
GW_BILLING_PROVIDER=newapi-billing
GW_BILLING_SVC_URL=https://s.aapi.cn/keypool

# keypool-service：上游 key 租约 + 渠道覆盖 + 路由提取配置 + 计费规则（唯一事实源）
# 全部渠道挂在统一分组（默认 keypool）下集中维护；接入新模型 = 渠道挂进分组 +
# 配 setting.gateway 块（含 billing.rule 计费规则），网关零维护
GW_KEY_PROVIDER=keypool
GW_KEY_SVC_URL=https://s.aapi.cn/keypool
GW_KEY_SVC_TOKEN=54aaea62149bd04a4896e6d14fe32c5a   # keypool 服务级 AUTH_TOKEN（强随机，两边一起换）
GW_KEY_GROUP=keypool                         # 统一分组名（渠道选择 group）

# ===== 网关自身 =====
# 注入上游 callback_url 的公网基址——必须是上游可达的公网地址；
# 填 127.0.0.1 会把不可达回调地址注入上游（supports_callback=true 的渠道直接炸）
GW_GATEWAY_PUBLIC_BASE_URL=https://dev.aapi.cn
GW_GATEWAY_PLATFORM=gateway                        # tasks.platform 标记
# GW_ADMIN_TOKEN=                                  # /ops/* X-Admin-Token；空则靠内网隔离
GW_HTTP_TIMEOUT=60

# ===== 计费闭环 =====
GW_FREEZE_TTL_SECONDS=1800                 # 预冻结 TTL（billing sweeper 过期自动解冻兜底）
GW_SK_SESSION_TTL_SECONDS=172800           # 用户令牌 Redis 暂存 TTL（终态结算用）
GW_FREEZE_RENEW_MARGIN_SECONDS=600         # 冻结临期续期阈值（HELD/长任务防过期）
GW_FREEZE_RENEW_BATCH=100                  # 每轮 sweep 续期上限
GW_HOLD_MAX_AGE_SECONDS=14400              # HELD 挂起上限（4h，超时判死 FAILURE+解冻）

# ===== 鉴权/幂等/限流 =====
GW_AUTH_CACHE_TTL=30
GW_IDEM_TTL=86400
GW_RATE_LIMIT_PER_MINUTE=60
GW_MAX_CONCURRENT_TASKS=5

# ===== 用户回调投递 =====
# 强随机值（openssl rand -hex 16）；占位 change-me 禁止上生产
GW_CALLBACK_SIGN_SECRET=8f32b0fd61a38b92114af283b0c712be
GW_CB_DEDUP_TTL=259200

# ===== 探测（不支持回调的上游）=====
GW_POLL_LADDER_SECONDS=5,15,30,120
GW_POLL_MAX_AGE_SECONDS=86400
GW_TASK_STALE_SECONDS=300
# 提交重试：仅换 key 可能改变结果的确定性拒绝（模糊失败绝不重试防双重创建）
GW_SUBMIT_MAX_ATTEMPTS=3
GW_SUBMIT_RETRYABLE_STATUS_CODES=401,403,429
# 不亏本兜底：孤儿任务宽限 / 反向对账抽查
GW_ORPHAN_GRACE_SECONDS=600
GW_REVERSE_RECONCILE_BATCH=20
GW_REVERSE_RECONCILE_WINDOW_SECONDS=86400
GW_REVERSE_RECONCILE_RECHECK_SECONDS=3600

# ===== 队列 =====
GW_EVENT_MAX_ATTEMPTS=8
GW_QUEUE_WARN_DEPTH=500
GUNICORN_WORKERS=3
# taskiq-admin 看板（可选；配了 worker 才上报；面板只绑 127.0.0.1:3000）
# GW_TASKIQ_ADMIN_URL=http://taskiq-admin:3000
# GW_TASKIQ_ADMIN_API_TOKEN=          # 强随机（openssl rand -hex 16），与看板 TASKIQ_ADMIN_API_TOKEN 一致

# ===== 观测 =====
# 日志：loguru 统一装配（app/logging.py），级别 DEBUG/INFO/WARNING/ERROR
GW_LOG_LEVEL=INFO
GW_LOGFIRE_ENABLED=true
GW_LOGFIRE_TOKEN=pylf_v1_us_XxJnLTnSx8cCzx0KYtThytbN1x9xvJWN9fGMcFKNLG8r
# logfire 噪音路由排除（逗号分隔；探针与运维端点不进 trace 面板）
GW_LOGFIRE_EXCLUDED_URLS=/healthz/live,/healthz/ready,/ops/queue,/ops/requeue,/ops/dlq/replay,/ops/tasks
